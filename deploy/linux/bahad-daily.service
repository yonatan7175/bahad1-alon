# /etc/systemd/system/bahad-daily.service — daily cleanup (old push rows, rate-limit counters).
[Unit]
Description=Bahad: daily cleanup
After=bahad.service

[Service]
Type=oneshot
User=bahad
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 120 -X POST -H @/etc/bahad/cron-header http://127.0.0.1:3000/api/cron/daily
