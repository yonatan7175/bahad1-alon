# /etc/bahad/env  (chown root:bahad, chmod 640) — see .env.example for every variable.
# Option A: Supabase for Auth + DB + Realtime (same as Vercel), Node on this box.
BAHAD_AUTH=supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_CA_CERT=
NEXT_PUBLIC_BAHAD_REALTIME=sse
BAHAD_INTERNAL_CRON=1

# Option B (everything except Google sign-in on this box): own Postgres + Supabase Auth.
# DATABASE_URL=postgresql://bahad:<password>@127.0.0.1:5432/bahad
# BAHAD_AUTH_SHIM=1

BAHAD_ADMIN_EMAILS=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=https://portal.example.com
NEXT_PUBLIC_REPO_URL=
