# Production site on 127.0.0.1:3000 (Caddy → https://bahad1-alon.duckdns.org).
# Install: cp deploy/local/systemd/*.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#          systemctl --user enable --now alon-prod alon-dev   (needs: loginctl enable-linger)
[Unit]
Description=Alon portal — production (:3000)
After=network-online.target

[Service]
WorkingDirectory=%h/AlonSite
Environment=PATH=%h/.local/opt/node/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
ExecStart=%h/.local/opt/node/bin/node %h/AlonSite/node_modules/next/dist/bin/next start -p 3000 -H 127.0.0.1
Environment=BAHAD_DIST_DIR=.next-prod
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
