          "status": {
            "type": "string",
            "enum": [
              "open",
              "in_progress",
              "closed"
            ]
          },
          "slot": {
            "type": "string",
            "description": "\"open\" while open (one open request per room+item); the record id once closed",
            "pattern": "^(open|[0-9a-f-]{36})$"
          },
          "reply": {
            "type": "string",
            "maxLength": 200
          },
          "handledBy": {
            "type": "string",
            "maxLength": 40
          },
          "closedAt": {
            "type": "string",
            "maxLength": 40
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "item": {
                  "enum": [
                    "other",
                    "other_missing",
                    "building"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "note"
              ],
              "properties": {
                "note": {
                  "minLength": 2
                }
              }
            }
          }
        ]
      }
    },
    "plus": {
