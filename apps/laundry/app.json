{
  "slug": "laundry",
  "name": "לו\"ז מכונות כביסה",
  "description": "שריון מכונות הכביסה (קומה 1, קומה 3) והמייבש: משבצות של 40 דקות, רואים מי שריין ואת הטלפון שלו",
  "tier": "full",
  "icon": "icon.svg",
  "tags": [
    "יומיומי",
    "לוגיסטיקה"
  ],
  "authors": [
    "REPLACE-ME"
  ],
  "status": "beta",
  "audience": [
    "cadet",
    "commander",
    "admin"
  ],
  "scopes": [
    "profile",
    "role",
    "unit",
    "contact",
    "push",
    "directory"
  ],
  "collections": {
    "bookings": {
      "read": "all",
      "create": "any",
      "moderate": "commander",
      "unique": [
        "machine",
        "day",
        "time"
      ],
      "quota": [
        {
          "max": 2,
          "period": "week",
          "dateField": "day",
          "match": {
            "kind": "washer"
          }
        },
        {
          "max": 2,
          "period": "week",
          "dateField": "day",
          "match": {
            "kind": "dryer"
          }
        }
      ],
      "schema": {
        "type": "object",
        "required": [
          "machine",
          "kind",
          "day",
          "time",
          "start"
        ],
        "properties": {
          "machine": {
            "type": "string",
            "enum": [
              "w1",
              "w3",
              "d1"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "washer",
              "dryer"
            ]
          },
          "day": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "time": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):(00|20|40)$"
          },
          "start": {
            "type": "string",
            "maxLength": 40
          },
          "phone": {
            "type": "string",
            "maxLength": 20,
            "pattern": "^[0-9+][0-9 -]{6,19}$"
          },
          "reminderId": {
            "type": "string",
            "maxLength": 40
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "machine": {
                  "pattern": "^w"
                }
              }
            },
            "then": {
              "properties": {
                "kind": {
                  "const": "washer"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "machine": {
                  "pattern": "^d"
                }
              }
            },
            "then": {
              "properties": {
                "kind": {
                  "const": "dryer"
                }
              }
            }
          }
        ]
      },
      "window": {
        "dateField": "day",
        "maxDaysAhead": 28
      }
    },
    "machine_status": {
      "read": "all",
      "create": "commander",
      "moderate": "commander",
      "unique": [
        "machine"
      ],
      "schema": {
        "type": "object",
        "required": [
          "machine",
          "broken"
        ],
        "properties": {
          "machine": {
            "type": "string",
            "enum": [
              "w1",
              "w3",
              "d1"
            ]
          },
          "broken": {
            "type": "boolean"
          },
          "note": {
            "type": "string",
            "maxLength": 80
          }
        },
        "additionalProperties": false
      }
    }
  },
  "version": "3.0.0"
}
