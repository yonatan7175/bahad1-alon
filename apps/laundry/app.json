{
  "slug": "laundry",
  "name": "לו\"ז מכונות כביסה",
  "description": "שריון מכונת הכביסה והמייבש: משבצות של 40 דקות, את כל המכונה או בחלוקה עם עוד אחד, רואים מי שריין ואת הטלפון שלו",
  "tier": "full",
  "icon": "icon.svg",
  "tags": [
    "יומיומי",
    "לוגיסטיקה"
  ],
  "authors": [
    "REPLACE-ME"
  ],
  "status": "live",
  "audience": [
    "cadet",
    "commander",
    "admin"
  ],
  "scopes": [
    "profile",
    "role",
    "unit",
    "contact",
    "push",
    "directory"
  ],
  "collections": {
    "bookings": {
      "read": "all",
      "create": "any",
      "moderate": "commander",
      "capacity": {
        "keys": [
          "machine",
          "day",
          "time"
        ],
        "max": 2,
        "sizeField": "seats"
      },
      "quota": [
        {
          "max": 3,
          "period": "week",
          "dateField": "day",
          "match": {
            "kind": "washer"
          }
        },
        {
          "max": 3,
          "period": "week",
          "dateField": "day",
          "match": {
            "kind": "dryer"
          }
        }
      ],
      "schema": {
        "type": "object",
        "required": [
          "machine",
          "kind",
          "day",
          "time",
          "seats",
          "start"
        ],
        "properties": {
          "machine": {
            "type": "string",
            "enum": [
              "w1",
              "d1"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "washer",
              "dryer"
            ]
          },
          "day": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "time": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):(00|20|40)$"
          },
          "seats": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "description": "2 = the whole machine, 1 = shared with one more person"
          },
          "start": {
            "type": "string",
            "maxLength": 40
          },
          "phone": {
            "type": "string",
            "maxLength": 20,
            "pattern": "^[0-9+][0-9 -]{6,19}$"
          },
          "reminderId": {
            "type": "string",
            "maxLength": 40
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "machine": {
                  "pattern": "^w"
                }
              }
            },
            "then": {
              "properties": {
                "kind": {
                  "const": "washer"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "machine": {
                  "pattern": "^d"
                }
              }
            },
            "then": {
              "properties": {
                "kind": {
                  "const": "dryer"
                }
              }
            }
          }
        ]
      },
      "window": {
        "dateField": "day",
        "maxDaysAhead": 28
      }
    },
    "machine_status": {
      "read": "all",
      "create": "commander",
      "moderate": "commander",
      "unique": [
        "machine"
      ],
      "schema": {
        "type": "object",
        "required": [
          "machine",
          "broken"
        ],
        "properties": {
          "machine": {
            "type": "string",
            "enum": [
              "w1",
              "d1"
            ]
          },
          "broken": {
            "type": "boolean"
          },
          "note": {
            "type": "string",
            "maxLength": 80
          }
        },
        "additionalProperties": false
      }
    },
    "legacy": {
      "read": "all",
      "create": "admin",
      "moderate": "admin",
      "schema": {
        "type": "object",
        "required": [
          "machine",
          "day",
          "from",
          "to",
          "name"
        ],
        "properties": {
          "machine": {
            "type": "string",
            "enum": [
              "w1",
              "d1"
            ]
          },
          "day": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "from": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "description": "Real start time from the old calendar (not on the 40-minute grid)"
          },
          "to": {
            "type": "string",
            "pattern": "^(([01]\\d|2[0-3]):[0-5]\\d|24:00)$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "phones": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "string",
              "maxLength": 20,
              "pattern": "^[0-9+][0-9 -]{6,19}$"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "version": "4.1.0"
}
