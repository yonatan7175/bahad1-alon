# ─── Copy to .env.local (local) / set in Vercel or /etc/bahad/env (Linux). Never commit real values. ───

# Auth: "google" (direct Google sign-in, no Supabase), "supabase", or "mock" (local dev / tests).
# Default: supabase if NEXT_PUBLIC_SUPABASE_URL is set, else google if GOOGLE_CLIENT_ID is set, else mock.
# Mock is refused in production builds unless BAHAD_ALLOW_MOCK=1 (only for local test runs).
BAHAD_AUTH=mock

# Direct Google sign-in (BAHAD_AUTH=google). Google Cloud → Credentials → OAuth client ID (Web).
# Authorized redirect URI: <NEXT_PUBLIC_SITE_URL>/auth/google/callback. Users live in the local auth.users
# table (embedded PGlite in dev; own Postgres + `pnpm db:migrate --shim` in production).
GOOGLE_CLIENT_ID=
# SECRET
GOOGLE_CLIENT_SECRET=
# SECRET: signs the session cookie (openssl rand -hex 32). Changing it signs everyone out.
BAHAD_SESSION_SECRET=

# Supabase (Project Settings → API). The anon/publishable key is public by design (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET: server only (realtime broadcast, banning blocked users, deleting users). Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Database. Supabase: Project Settings → Database → connection string.
#   Vercel/serverless: the transaction pooler (port 6543). Migrations: the session pooler or direct (5432).
# Empty = embedded PGlite in .data/pglite (local only; refused in production unless BAHAD_ALLOW_PGLITE=1).
DATABASE_URL=
# PEM of the database CA (Supabase: Database settings → SSL → download certificate). Literal \n allowed.
DATABASE_CA_CERT=
DATABASE_POOL_MAX=5
BAHAD_PGLITE_DIR=.data/pglite

# 1 = DATABASE_URL is your own Postgres (with the auth shim, `pnpm db:migrate --shim`) while sign-in
# still uses Supabase Auth: identities are mirrored into the local auth.users table. See LINUX.md.
BAHAD_AUTH_SHIM=0

# Realtime "changed" signals: "supabase" (Vercel) or "sse" (single Node process: local / Linux box).
# Default: supabase when BAHAD_AUTH=supabase, else sse.
NEXT_PUBLIC_BAHAD_REALTIME=

# Bootstrap: these Google emails become approved admins on first sign-in (comma separated).
BAHAD_ADMIN_EMAILS=
# Plan Q3: let commanders approve new users from their own company (1 = yes).
BAHAD_COMMANDERS_CAN_APPROVE=0
# 1 = new users wait for an admin (or commander) to approve them after registering. Default (empty/0): registering creates the account right away.
BAHAD_REQUIRE_APPROVAL=0

# Web Push (pnpm vapid generates a pair). Public key is public; private key is SECRET.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# SECRET shared with pg_cron / systemd timer for /api/cron/* (long random string: openssl rand -hex 32).
CRON_SECRET=
# 1 = send due push every minute from inside the Node process (local / single Linux box without a timer).
BAHAD_INTERNAL_CRON=0

# Dev server opened from other devices (Tailscale / LAN IPs, comma separated). Dev only.
BAHAD_DEV_ORIGINS=

# Site
NEXT_PUBLIC_SITE_NAME=אתר הבית — גדוד אלון
NEXT_PUBLIC_SITE_SHORT_NAME=גדוד אלון
NEXT_PUBLIC_SCHOOL_NAME=בה״ד 1
# Emblem image in public/brand/ (e.g. /brand/emblem.svg). Only after approval to use the official insignia (plan Q1, קב"ם).
NEXT_PUBLIC_EMBLEM_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_THEME_COLOR=#335c81
NEXT_PUBLIC_REPO_URL=
NEXT_PUBLIC_CONTACT_URL=
NEXT_PUBLIC_DISABLE_SW=0

# Linux self-host: build .next/standalone (see LINUX.md)
BAHAD_STANDALONE=0
