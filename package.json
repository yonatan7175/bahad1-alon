{
  "name": "bahad-main-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen": "tsx scripts/gen.ts",
    "dev": "pnpm gen && next dev",
    "build": "pnpm gen && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "pnpm gen && next typegen && tsc --noEmit",
    "test": "pnpm gen && vitest run",
    "e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm docs:check",
    "docs:check": "tsx scripts/build-docs.ts --check",
    "docs:sync": "tsx scripts/build-docs.ts --sync-claude",
    "db:migrate": "tsx scripts/migrate.ts",
    "vapid": "tsx scripts/gen-vapid.ts",
    "icons": "tsx scripts/make-icons.ts",
    "codeowners": "tsx scripts/gen-codeowners.ts",
    "check:paths": "tsx scripts/check-pr-paths.ts",
    "check:scan": "tsx scripts/scan-simple-apps.ts",
    "scope-diff": "tsx scripts/scope-diff.ts",
    "course-end": "tsx scripts/course-end-cleanup.ts",
    "backup": "bash scripts/backup.sh",
    "set-owner": "tsx scripts/set-owner.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fontsource-variable/heebo": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "ajv": "^8.20.0",
    "lucide-react": "^1.73.0",
    "marked": "^18.2.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.19",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
